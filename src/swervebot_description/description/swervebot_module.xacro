<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Include subsystem files -->
    <xacro:include filename="$(find swervebot_description)/description/swervebot_wheel.xacro" />
    <xacro:include filename="$(find swervebot_description)/description/swervebot_actuator.xacro" />

    <!-- ============================================ -->
    <!--          Create One Swerve Module            -->
    <!-- ============================================ -->

    <xacro:macro name="add_swerve_module" params="name actuator_x actuator_y actuator_z wheel_x wheel_y wheel_z parent_link:=chassis">

        <xacro:swervebot_actuator
            name="actuator_${name}"
            x="${actuator_x}"
            y="${actuator_y}"
            z="${actuator_z}"
            parent_link="${parent_link}" />

        <xacro:swervebot_wheel
            name="wheel_${name}"
            x="${wheel_x}"
            y="${wheel_y}"
            z="${wheel_z}"
            parent_link="actuator_${name}" />

    </xacro:macro>

    <!-- ============================================ -->
    <!--       Create All Four Swerve Modules         -->
    <!-- ============================================ -->
    <!-- Change the module name here and make sure it -->
    <!-- matches the controllers.yaml with prefix     -->
    <!-- from above and suffix "_joint"    -->

    <xacro:macro name="add_all_swerve_modules">

        <!-- Front Left -->
        <xacro:add_swerve_module
            name="${module_1}"
            actuator_x="${module_1_x}"
            actuator_y="${module_1_y}"
            actuator_z="${module_1_z}"
            wheel_x="${module_1_wheel_x}"
            wheel_y="${module_1_wheel_y}"
            wheel_z="${module_1_wheel_z}"/>

        <!-- Front Right -->
        <xacro:add_swerve_module
            name="${module_2}"
            actuator_x="${module_2_x}"
            actuator_y="${module_2_y}"
            actuator_z="${module_2_z}"
            wheel_x="${module_2_wheel_x}"
            wheel_y="${module_2_wheel_y}"
            wheel_z="${module_2_wheel_z}"/>

        <!-- Back Left -->
        <xacro:add_swerve_module
            name="${module_3}"
            actuator_x="${module_3_x}"
            actuator_y="${module_3_y}"
            actuator_z="${module_3_z}"
            wheel_x="${module_3_wheel_x}"
            wheel_y="${module_3_wheel_y}"
            wheel_z="${module_3_wheel_z}"/>

        <!-- Back Right -->
        <xacro:add_swerve_module
            name="${module_4}"
            actuator_x="${module_4_x}"
            actuator_y="${module_4_y}"
            actuator_z="${module_4_z}"
            wheel_x="${module_4_wheel_x}"
            wheel_y="${module_4_wheel_y}"
            wheel_z="${module_4_wheel_z}"/>

    </xacro:macro>

</robot>