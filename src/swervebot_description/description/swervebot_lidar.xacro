<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Mount pose is parent-relative; base_link is at the chassis center. -->
    <xacro:macro name="swervebot_lidar" params="use_sim parent_link:=${lidar_parent} xyz:='${lidar_x} ${lidar_y} ${lidar_z}' rpy:=${lidar_rpy} radius:=${lidar_radius} height:=${lidar_height} mass:=${lidar_mass}">
        <link name="laser_frame">
            <visual>
                <geometry><cylinder radius="${radius}" length="${height}"/></geometry>
                <material name="lidar_material"><color rgba="${lidar_color}"/></material>
            </visual>
            <collision>
                <geometry><cylinder radius="${radius}" length="${height}"/></geometry>
            </collision>
            <inertial>
                <mass value="${mass}"/>
                <xacro:cylinder_inertia_values m="${mass}" r="${radius}" h="${height}"/>
            </inertial>
        </link>
        <joint name="laser_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="laser_frame"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
        <xacro:if value="${use_sim}">
            <gazebo reference="laser_frame">
                <sensor name="rplidar_c1" type="gpu_lidar">
                    <topic>${lidar_topic}</topic>
                    <!-- Keep the ROS frame stable after Gazebo fixed-joint reduction. -->
                    <gz_frame_id>laser_frame</gz_frame_id>
                    <visualize>true</visualize>
                    <update_rate>${lidar_update_rate}</update_rate>
                    <ray>
                        <scan>
                            <horizontal>
                                <samples>${lidar_samples}</samples>
                                <resolution>${lidar_angle_res}</resolution>
                                <min_angle>${lidar_min_angle}</min_angle>
                                <max_angle>${lidar_max_angle}</max_angle>
                            </horizontal>
                        </scan>
                        <range>
                            <min>${lidar_min_range}</min>
                            <max>${lidar_max_range}</max>
                            <resolution>${lidar_range_res}</resolution>
                        </range>
                    </ray>
                </sensor>
            </gazebo>
        </xacro:if>
    </xacro:macro>
</robot>
