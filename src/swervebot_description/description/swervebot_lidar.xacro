<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Include the properties file to access the defined properties -->
    <xacro:include filename="$(find swervebot_description)/description/swervebot_properties.xacro" />
    <xacro:include filename="$(find swervebot_description)/description/inertia.xacro" />

    <link name="laser_frame">
        <visual>
            <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
            <material name="${lidar_color}"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
        </collision>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo-specific configurations for ray tracing -->
    <gazebo reference="laser_frame">
        <sensor name="rplidar_c1" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
            <scan>
                <horizontal>
                <samples>${lidar_samples}</samples>
                <resolution>${lidar_angle_res}</resolution>
                <min_angle>-${lidar_min_angle}</min_angle>
                <max_angle>${lidar_max_angle}</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>${lidar_min_range}</min>
                <max>${lidar_max_range}</max>
                <resolution>${lidar_range_res}</resolution>
            </range>
            </ray>
            <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
            <ros>
                <namespace>/</namespace>
                <remapping>~/out:=scan</remapping>
            </ros>
            </plugin>
        </sensor>
    </gazebo>
</robot>