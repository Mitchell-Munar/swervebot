<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- ============================================ -->
  <!-- Global Robot Geometry & Kinematic Parameters -->
  <!-- (Match these with the controller YAML)       -->
  <!-- ============================================ -->
  <xacro:property name="wheelbase" value="0.26"/>
  <xacro:property name="track_width" value="0.24"/>

  <!-- Wheel Geometry & Mass -->
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <!-- Actuator Geometry & Mass -->
  <xacro:property name="actuator_radius" value="0.02"/>
  <xacro:property name="actuator_height" value="0.2"/>
  <xacro:property name="actuator_mass" value="2.0"/>

  <!-- Chassis Geometry & Mass -->
  <xacro:property name="chassis_length" value="0.3" />
  <xacro:property name="chassis_width" value="0.2" />
  <xacro:property name="chassis_height" value="0.15" />
  <xacro:property name="chassis_mass" value="5.0" />
  
  <!-- Wheel Offset From Actuator Rotation Axis -->
  <xacro:property name="wheel_offset_x" value="0.0"/> 
  <xacro:property name="wheel_offset_y" value="0.045"/> 
  <xacro:property name="wheel_offset_z" value="-0.1"/>
  
  <!-- Actuator Offset In Vertical Direction -->
  <xacro:property name="actuator_offset_z" value="-0.025"/>

  <!-- Chassis Ground Clearance -->
  <xacro:property name="chassis_ground_clearance" value="${wheel_radius - actuator_offset_z - wheel_offset_z - chassis_height/2}" />

  <!-- Lidar Properties -->
  <xacro:property name="lidar_radius" value="0.03"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.1"/>
  <xacro:property name="lidar_samples" value="500"/>
  <xacro:property name="lidar_angle_res" value="1"/>
  <xacro:property name="lidar_min_angle" value="-3.14159"/>
  <xacro:property name="lidar_max_angle" value="3.14159"/>
  <xacro:property name="lidar_min_range" value="0.05"/>
  <xacro:property name="lidar_max_range" value="12.0"/>
  <xacro:property name="lidar_range_res" value="0.01"/>

  <!-- Lidar Position -->
  <xacro:property name="lidar_x" value="0.15"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="${chassis_ground_clearance + chassis_height + (lidar_height / 2)}"/>

  <!--   ~ LIMITS ~    -->
  <!-- Actuator Limits -->
  <!--  (In radians)   -->
  <xacro:property name="actuator_pos_min" value="${-pi/2}"/>
  <xacro:property name="actuator_pos_max" value="${pi/2}"/>

  <!-- Simulation design limits, not measured physical actuator specifications. -->
  <xacro:property name="actuator_velocity_limit" value="10.0"/>
  <xacro:property name="actuator_effort_limit" value="10.0"/>
  <xacro:property name="wheel_velocity_limit" value="30.0"/>
  <xacro:property name="wheel_effort_limit" value="10.0"/>

  <!-- Material & Visual Properties -->
  <xacro:property name="wheel_color" value="0.1 0.1 0.1 1.0"/>
  <xacro:property name="chassis_color" value="0.7 0.7 0.7 1.0"/>
  <xacro:property name="actuator_color" value="1 0.5 0.5 1.0" />
  <xacro:property name="lidar_color" value="0.9 0.9 0.9 1.0" />

  <!-- ============================================ -->
  <!--                 Module Names                 -->
  <!-- (These will have prefixes and sufixes added) -->
  <!-- ============================================ -->
  <xacro:property name="module_1" value="front_left"/>
  <xacro:property name="module_2" value="front_right"/>
  <xacro:property name="module_3" value="back_left"/>
  <xacro:property name="module_4" value="back_right"/>

</robot>