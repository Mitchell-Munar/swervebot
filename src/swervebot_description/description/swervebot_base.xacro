<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Configuration and inertia helpers are loaded by the assembly entrypoint. -->

    <xacro:macro name="swervebot_base" params="length:=${chassis_length} width:=${chassis_width} height:=${chassis_height} mass:=${chassis_mass}" >

        <link name="base_footprint" />

        <joint name="base_footprint_joint" type="fixed">
            <parent link="base_footprint" />
            <child link="base_link" />
            <origin xyz="0 0 ${chassis_ground_clearance + (chassis_height/2)}" rpy="0 0 0" />
        </joint>

        <link name="base_link" />

        <joint name="chassis_joint" type="fixed">
            <parent link="base_link" />
            <child link="chassis" />
            <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>

        <link name="chassis">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${length} ${width} ${height}" />
                </geometry>
                <material name="chassis_material">
                    <color rgba="${chassis_color}" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${length} ${width} ${height}" />
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="${mass}" />
                <xacro:box_inertia_values m="${mass}" x="${length}" y="${width}" z="${height}" />
            </inertial>
        </link>
    </xacro:macro>
</robot>