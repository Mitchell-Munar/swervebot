<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Configuration and inertia helpers are loaded by the assembly entrypoint. -->

    <xacro:macro name="swervebot_wheel" params="name x y z parent_link radius:=${wheel_radius} width:=${wheel_width} mass:=${wheel_mass}">

        <joint name="${name}_joint" type="continuous">
            <parent link="${parent_link}" />
            <child link="${name}" />
            <origin xyz="${x} ${y} ${z}" rpy="${-pi/2} 0 0" />
            <!-- Rotate local +z onto body +y: positive wheel rotation rolls body +x. -->
            <axis xyz="0 0 1" />
            <limit effort="${wheel_effort_limit}" velocity="${wheel_velocity_limit}"/>
        </joint>

        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${radius}" length="${width}" />
                </geometry>
                <material name="wheel_material">
                    <color rgba="${wheel_color}" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${radius}" length="${width}" />
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="${mass}" />
                <xacro:cylinder_inertia_values m="${mass}" r="${radius}" h="${width}" />
            </inertial>
        </link>
    </xacro:macro>
</robot>