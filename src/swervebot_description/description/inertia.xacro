<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="box_inertia_values" params="m x y z">
        <inertia ixx="${(1/12) * m * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * m * (x*x + z*z)}" iyz="0.0"
                    izz="${(1/12) * m * (x*x + y*y)}" />
    </xacro:macro>

    <xacro:macro name="cylinder_inertia_values" params="m r h">
        <inertia ixx="${(1/12) * m * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * m * (3*r*r + h*h)}" iyz="0.0"
                    izz="${(1/2) * m * (r*r)}" />
    </xacro:macro>
    
</robot>