<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Include the properties file to access the defined properties -->
    <xacro:include filename="$(find swervebot_description)/description/swervebot_properties.xacro" />

    <xacro:macro name="robot_control" params="use_mock_hardware use_sim controller_config">

        <ros2_control name="SwerveBotSystem" type="system">
            <!-- Mock Hardware -->
            <xacro:if value="${use_mock_hardware}">
                <hardware>
                    <plugin>mock_components/GenericSystem</plugin>
                    <param name="calculate_dynamics">true</param>
                </hardware>
            </xacro:if>

            <!-- Gazebo Simulation -->
            <xacro:if value="${use_sim}">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:if>

            <!-- Real Hardware -->
            <xacro:unless value="${use_mock_hardware or use_sim}">
                <hardware>
                    <plugin>my_robot_hardware/MyRobotHardwareInterface</plugin>
                    <param name="usb_port">/dev/ttyUSB0</param>
                    <param name="baud_rate">115200</param>
                </hardware>
            </xacro:unless>

            <!-- ============================================ -->
            <!--             Module 1: Steering               -->
            <!-- ============================================ -->

            <joint name="actuator_${module_1}_joint">
                <command_interface name="position">
                    <param name="min">${actuator_pos_min}</param>
                    <param name="max">${actuator_pos_max}</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <!-- Module 1: Drive Wheel -->
            <joint name="wheel_${module_1}_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <!-- ============================================ -->
            <!--             Module 2: Steering               -->
            <!-- ============================================ -->

            <joint name="actuator_${module_2}_joint">
                <command_interface name="position">
                    <param name="min">${actuator_pos_min}</param>
                    <param name="max">${actuator_pos_max}</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <!-- Module 2: Drive Wheel -->
            <joint name="wheel_${module_2}_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <!-- ============================================ -->
            <!--             Module 3: Steering               -->
            <!-- ============================================ -->

            <joint name="actuator_${module_3}_joint">
                <command_interface name="position">
                    <param name="min">${actuator_pos_min}</param>
                    <param name="max">${actuator_pos_max}</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <!-- Module 3: Drive Wheel -->
            <joint name="wheel_${module_3}_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <!-- ============================================ -->
            <!--             Module 4: Steering               -->
            <!-- ============================================ -->

            <joint name="actuator_${module_4}_joint">
                <command_interface name="position">
                    <param name="min">${actuator_pos_min}</param>
                    <param name="max">${actuator_pos_max}</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <!-- Module 4: Drive Wheel -->
            <joint name="wheel_${module_4}_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>        
        </ros2_control>

        <!-- Model poses are diagnostics, never a second publisher of odom -> base TF. -->
        <xacro:if value="${use_sim}">
            <gazebo>
                <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
                    <!-- Fix the topic explicitly; URDF conversion may change scoped names. -->
                    <topic>/model/swervebot/pose</topic>
                    <publish_link_pose>false</publish_link_pose>
                    <publish_sensor_pose>false</publish_sensor_pose>
                    <publish_collision_pose>false</publish_collision_pose>
                    <publish_visual_pose>false</publish_visual_pose>
                    <publish_model_pose>true</publish_model_pose>
                    <publish_nested_model_pose>false</publish_nested_model_pose>
                    <use_pose_vector_msg>true</use_pose_vector_msg>
                    <update_frequency>50</update_frequency>
                </plugin>
            </gazebo>
        </xacro:if>

        <!-- Gazebo ROS 2 Control Plugin -->
        <xacro:if value="${use_sim}">
            <gazebo>
                <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>${controller_config}</parameters>
                    <controller_manager_name>controller_manager</controller_manager_name>
                    <hardware_init_timeout>30.0</hardware_init_timeout>
                    <!-- Gain maps position error to joint velocity at the controller rate. -->
                    <position_proportional_gain>0.1</position_proportional_gain>
                </plugin>
            </gazebo>
        </xacro:if>

    </xacro:macro>

</robot>