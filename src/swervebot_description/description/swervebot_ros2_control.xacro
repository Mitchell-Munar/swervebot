<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Configuration and inertia helpers are loaded by the assembly entrypoint. -->

    <!-- One steering position interface and one drive velocity interface per module. -->
    <xacro:macro name="module_control" params="name">
        <joint name="actuator_${name}_joint">
            <command_interface name="position">
                <param name="min">${actuator_pos_min}</param>
                <param name="max">${actuator_pos_max}</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="wheel_${name}_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="robot_control" params="use_mock_hardware use_sim controller_config">

        <!-- Fail during expansion rather than emit two competing hardware implementations. -->
        <xacro:if value="${use_mock_hardware and use_sim}">
            <xacro:property name="invalid_hardware" value="${xacro.fatal('use_mock_hardware and use_sim are mutually exclusive')}" lazy_eval="false"/>
        </xacro:if>
        <ros2_control name="SwerveBotSystem" type="system">
            <!-- Mock Hardware -->
            <xacro:if value="${use_mock_hardware}">
                <hardware>
                    <plugin>mock_components/GenericSystem</plugin>
                    <param name="calculate_dynamics">true</param>
                </hardware>
            </xacro:if>

            <!-- Gazebo Simulation -->
            <xacro:if value="${use_sim}">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:if>

            <!-- Real Hardware -->
            <xacro:unless value="${use_mock_hardware or use_sim}">
                <hardware>
                    <plugin>my_robot_hardware/MyRobotHardwareInterface</plugin>
                    <param name="usb_port">/dev/ttyUSB0</param>
                    <param name="baud_rate">115200</param>
                </hardware>
            </xacro:unless>

            <xacro:module_control name="${module_1}"/>
            <xacro:module_control name="${module_2}"/>
            <xacro:module_control name="${module_3}"/>
            <xacro:module_control name="${module_4}"/>
        </ros2_control>

        <!-- Model poses are diagnostics, never a second publisher of odom -> base TF. -->
        <xacro:if value="${use_sim}">
            <gazebo>
                <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
                    <!-- Fix the topic explicitly; URDF conversion may change scoped names. -->
                    <topic>/model/swervebot/pose</topic>
                    <publish_link_pose>false</publish_link_pose>
                    <publish_sensor_pose>false</publish_sensor_pose>
                    <publish_collision_pose>false</publish_collision_pose>
                    <publish_visual_pose>false</publish_visual_pose>
                    <publish_model_pose>true</publish_model_pose>
                    <publish_nested_model_pose>false</publish_nested_model_pose>
                    <use_pose_vector_msg>true</use_pose_vector_msg>
                    <update_frequency>50</update_frequency>
                </plugin>
            </gazebo>
        </xacro:if>

        <!-- Gazebo ROS 2 Control Plugin -->
        <xacro:if value="${use_sim}">
            <gazebo>
                <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>${controller_config}</parameters>
                    <controller_manager_name>controller_manager</controller_manager_name>
                    <hardware_init_timeout>30.0</hardware_init_timeout>
                    <!-- Gain maps position error to joint velocity at the controller rate. -->
                    <position_proportional_gain>0.1</position_proportional_gain>
                </plugin>
            </gazebo>
        </xacro:if>

    </xacro:macro>

</robot>