<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Configuration and inertia helpers are loaded by the assembly entrypoint. -->

    <xacro:macro name="swervebot_actuator" params="name x y z parent_link radius:=${actuator_radius} height:=${actuator_height} mass:=${actuator_mass}">

        <joint name="${name}_joint" type="revolute">
            <parent link="${parent_link}" />
            <child link="${name}" />
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <!-- Mechanical travel must agree with the ros2_control command bounds. -->
            <limit lower="${actuator_pos_min}" upper="${actuator_pos_max}"
                   velocity="${actuator_velocity_limit}" effort="${actuator_effort_limit}"/>
        </joint>

        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${radius}" length="${height}" />
                </geometry>
                <material name="actuator_material">
                    <color rgba="${actuator_color}" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${radius}" length="${height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="${mass}" />
                <xacro:cylinder_inertia_values m="${mass}" r="${radius}" h="${height}" />
            </inertial>
        </link>
    </xacro:macro>
</robot>